{
  "name": "aether-visualizer",
  "productName": "Aether",
  "desktopName": "Aether.desktop",
  "version": "1.0.1",
  "description": "Aether - cinematic audio visualizer",
  "author": "SoCal AI Labs",
  "private": true,
  "type": "module",
  "main": "dist-electron/main.js",
  "scripts": {
    "dev": "vite",
    "build": "tsc -p tsconfig.node.json --noEmit && vite build",
    "preview": "vite preview",
    "dist": "npm run build && electron-builder --publish never",
    "dist:win": "npm run build && electron-builder --win nsis --publish never",
    "dist:mac": "npm run build && electron-builder --mac dmg zip --publish never",
    "dist:linux": "npm run build && electron-builder --linux AppImage deb --publish never",
    "dist:installer": "npm run dist:win"
  },
  "build": {
    "appId": "com.socalailabs.aether",
    "productName": "Aether",
    "directories": {
      "output": "release",
      "buildResources": "build"
    },
    "files": [
      "dist/**",
      "dist-electron/**",
      "package.json"
    ],
    "asar": true,
    "win": {
      "icon": "build/icon.png",
      "artifactName": "${productName}-Setup-${version}.${ext}",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true,
      "shortcutName": "Aether"
    },
    "mac": {
      "icon": "build/icon.png",
      "category": "public.app-category.music",
      "identity": null,
      "hardenedRuntime": false,
      "gatekeeperAssess": false,
      "notarize": false,
      "artifactName": "${productName}-${version}-mac-${arch}.${ext}",
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        },
        {
          "target": "zip",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ]
    },
    "dmg": {
      "sign": false
    },
    "linux": {
      "icon": "build/icon.png",
      "category": "AudioVideo",
      "maintainer": "SoCal AI Labs",
      "synopsis": "Cinematic audio visualizer",
      "syncDesktopName": true,
      "artifactName": "${productName}-${version}-linux-${arch}.${ext}",
      "desktop": {
        "entry": {
          "Name": "Aether",
          "Comment": "Aether - cinematic audio visualizer",
          "StartupWMClass": "Aether"
        }
      },
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "deb",
          "arch": [
            "x64"
          ]
        }
      ]
    }
  },
  "dependencies": {
    "electron-audio-loopback": "^1.0.6",
    "react": "^19.1.0",
    "react-dom": "^19.1.0",
    "three": "^0.176.0"
  },
  "devDependencies": {
    "@types/node": "^22.15.3",
    "@types/react": "^19.1.2",
    "@types/react-dom": "^19.1.2",
    "@types/three": "^0.176.0",
    "@vitejs/plugin-react": "^4.4.1",
    "electron": "^44.2.0",
    "electron-builder": "^26.15.3",
    "typescript": "^5.8.3",
    "vite": "^6.3.5",
    "vite-plugin-electron": "^0.29.0",
    "vite-plugin-electron-renderer": "^0.14.6"
  }
}
